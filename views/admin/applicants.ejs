<%- include('../partials/head') %>

<div class="container page-wrap">
  <div class="page-title-row">
    <div>
      <h1 class="page-title">👥 Student / Applicant Management</h1>
      <p class="page-sub">Search, filter, review and approve enrollment applications.</p>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-success btn-sm"
         href="/admin/applicants?<%= new URLSearchParams({q, gradeId, strandId, status, type, format:'csv'}).toString() %>">
        ⬇ Export CSV (Excel)
      </a>
      <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">🖨 Print List</button>
    </div>
  </div>

  <!-- Status filter pills -->
  <div class="filter-pills mb-3">
    <a href="/admin/applicants" class="<%= !status ? 'active' : '' %>">All</a>
    <a href="/admin/applicants?status=submitted" class="<%= status === 'submitted' ? 'active' : '' %>">Submitted (<%= counts.submitted %>)</a>
    <a href="/admin/applicants?status=under_review" class="<%= status === 'under_review' ? 'active' : '' %>">Under Review (<%= counts.under_review %>)</a>
    <a href="/admin/applicants?status=returned" class="<%= status === 'returned' ? 'active' : '' %>">Returned (<%= counts.returned %>)</a>
    <a href="/admin/applicants?status=approved" class="<%= status === 'approved' ? 'active' : '' %>">For Assessment (<%= counts.approved %>)</a>
    <a href="/admin/applicants?status=enrolled" class="<%= status === 'enrolled' ? 'active' : '' %>">Enrolled (<%= counts.enrolled %>)</a>
    <a href="/admin/applicants?status=rejected" class="<%= status === 'rejected' ? 'active' : '' %>">Rejected (<%= counts.rejected %>)</a>
  </div>

  <!-- Filters -->
  <div class="card card-body mb-3">
    <form method="get" action="/admin/applicants" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label">Search</label>
        <input class="form-control" name="q" value="<%= q %>" placeholder="Name, LRN, or reference no.">
      </div>
      <div class="col-md-2">
        <label class="form-label">Grade Level</label>
        <select class="form-select" name="grade">
          <option value="">All grades</option>
          <% grades.forEach(function(g) { %>
            <option value="<%= g.id %>" <%= String(gradeId) === String(g.id) ? 'selected' : '' %>><%= g.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label">Strand</label>
        <select class="form-select" name="strand">
          <option value="">All strands</option>
          <% strands.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= String(strandId) === String(s.id) ? 'selected' : '' %>><%= s.code %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label">Type</label>
        <select class="form-select" name="type">
          <option value="">All types</option>
          <option value="new" <%= type === 'new' ? 'selected' : '' %>>New</option>
          <option value="transferee" <%= type === 'transferee' ? 'selected' : '' %>>Transferee</option>
          <option value="returning" <%= type === 'returning' ? 'selected' : '' %>>Returning</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label">Status</label>
        <select class="form-select" name="status">
          <option value="">All statuses</option>
          <% Object.keys(STATUS_LABELS).forEach(function(s) { %>
            <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= STATUS_LABELS[s] %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-1 d-grid">
        <button class="btn btn-success">Go</button>
      </div>
    </form>
  </div>

  <!-- Bulk actions -->
  <form method="post" action="/admin/applicants/bulk" id="bulkForm"
        data-confirm="Approve all selected applications? Sections will be auto-assigned based on availability.">
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
      <% if (can('applicants')) { %>
        <button class="btn btn-success btn-sm" name="action" value="approve" type="submit">✔ Bulk Approve Selected</button>
      <% } %>
      <span class="hint">Tip: use the checkbox in the header to select all.</span>
    </div>

    <div class="card">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th style="width:36px"><input class="form-check-input" type="checkbox" id="masterCheck"
                    onclick="toggleCheckboxes('bulkForm','masterCheck')"></th>
              <th>Reference</th>
              <th>Student</th>
              <th>Type</th>
              <th>Grade / Strand</th>
              <th>Section</th>
              <th>Status</th>
              <th>Submitted</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="9" class="text-center text-muted py-5">No applications match your filters.</td></tr>
            <% } %>
            <% rows.forEach(function(r) { %>
              <tr>
                <td>
                  <% if (['submitted','under_review','returned'].includes(r.status) && can('applicants')) { %>
                    <input class="form-check-input" type="checkbox" name="ids" value="<%= r.id %>">
                  <% } %>
                </td>
                <td><a href="/admin/applicants/<%= r.id %>" class="fw-bold"><%= r.reference_no %></a></td>
                <td>
                  <strong><%= r.last_name %>, <%= r.first_name %></strong>
                  <% if (r.lrn) { %><div class="hint">LRN: <%= r.lrn %></div><% } %>
                </td>
                <td><span class="badge bg-light text-dark border"><%= r.enrollment_type %></span></td>
                <td><%= r.grade_name %><% if (r.strand_code) { %><div class="hint"><%= r.strand_code %></div><% } %></td>
                <td><%= r.section_name || '—' %></td>
                <td><span class="status-badge bg-<%= STATUS_COLORS[r.status] %>"><%= STATUS_LABELS[r.status] %></span></td>
                <td class="hint"><%= r.submitted_at ? r.submitted_at.slice(0,16) : '—' %></td>
                <td class="text-end">
                  <a class="btn btn-outline-primary btn-sm" href="/admin/applicants/<%= r.id %>">Open</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>
