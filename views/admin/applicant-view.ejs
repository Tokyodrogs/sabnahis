<%- include('../partials/head') %>
<%
  var studentName = h.fullName(app);
%>

<div class="container page-wrap">
  <div class="page-title-row">
    <div>
      <a class="hint" href="/admin/applicants">← Back to applicants</a>
      <h1 class="page-title"><%= studentName %></h1>
      <p class="page-sub">
        <span class="user-select-all"><%= app.reference_no %></span>
        · <%= app.type === 'early' ? 'Early Registration' : 'Application' %>
        · <span class="status-badge bg-<%= STATUS_COLORS[app.status] %>"><%= STATUS_LABELS[app.status] %></span>
        <% if (app.strand_code) { %> · <%= app.strand_code %><% } %>
        <% if (app.section_name) { %> · Section: <strong><%= app.section_name %></strong><% } %>
      </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-outline-secondary btn-sm" href="/admin/applicants?format=csv">⬇ Export List</a>
      <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">🖨 Print Profile</button>
    </div>
  </div>

  <div class="row g-3">
    <!-- ============================== LEFT: PROFILE ============================== -->
    <div class="col-lg-8">
      <div class="card mb-3">
        <div class="card-header">📄 Student Personal Information</div>
        <div class="card-body small">
          <div class="row mb-1">
            <div class="col-md-4"><strong>Full Name:</strong> <%= studentName %></div>
            <div class="col-md-4"><strong>Birthdate:</strong> <%= FMTD(app.birthdate) %></div>
            <div class="col-md-4"><strong>Gender:</strong> <%= app.gender || '—' %></div>
          </div>
          <div class="row mb-1">
            <div class="col-md-4"><strong>Civil Status:</strong> <%= app.civil_status || '—' %></div>
            <div class="col-md-4"><strong>Nationality:</strong> <%= app.nationality || '—' %></div>
            <div class="col-md-4"><strong>Religion:</strong> <%= app.religion || '—' %></div>
          </div>
          <div class="row mb-1">
            <div class="col-md-4"><strong>LRN:</strong> <%= app.lrn || '—' %></div>
            <div class="col-md-4"><strong>PSA Birth Cert:</strong> <%= app.psa_birth_cert_no || '—' %></div>
            <div class="col-md-4"><strong>Contact:</strong> <%= app.contact_number || '—' %></div>
          </div>
          <div class="row">
            <div class="col-12"><strong>Address:</strong> <%= app.home_address || '—' %></div>
          </div>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header">👪 Parent / Guardian</div>
        <div class="card-body small">
          <div class="row">
            <% guardians.forEach(function(g) { %>
              <div class="col-md-4 mb-2">
                <strong class="text-capitalize"><%= g.relationship %>:</strong><br>
                <%= h.fullName(g) %>
                <div class="hint">
                  <%= g.occupation || '—' %><br>
                  <%= g.contact_number || '—' %>
                </div>
              </div>
            <% }) %>
            <% if (!guardians.length) { %><div class="text-muted">No parent/guardian records.</div><% } %>
          </div>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header">🏫 Educational Background</div>
        <div class="card-body small">
          <% if (edu) { %>
            <div class="row">
              <div class="col-md-6"><strong>School:</strong> <%= edu.last_school_name %></div>
              <div class="col-md-6"><strong>Address:</strong> <%= edu.last_school_address || '—' %></div>
              <div class="col-md-4"><strong>S.Y. Completed:</strong> <%= edu.school_year_graded %></div>
              <div class="col-md-4"><strong>Average:</strong> <%= edu.general_average || '—' %></div>
              <div class="col-md-4"><strong>Grade Completed:</strong> <%= edu.grade_completed || '—' %></div>
              <% if (edu.reason_for_transfer) { %>
                <div class="col-12 mt-1"><strong>Reason for transfer:</strong> <%= edu.reason_for_transfer %></div>
              <% } %>
            </div>
          <% } else { %>
            <div class="text-muted">No educational background recorded yet.</div>
          <% } %>
        </div>
      </div>

      <!-- Documents -->
      <div class="card mb-3">
        <div class="card-header">📎 Uploaded Requirements</div>
        <div class="table-responsive">
          <table class="table mb-0 align-middle">
            <thead><tr><th>Document</th><th>File</th><th>Uploaded</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <%
                var docMap = {};
                docs.forEach(function(d){ docMap[d.doc_type] = d; });
              %>
              <% requirements.forEach(function(r) { %>
                <% var d = docMap[r.doc_type]; %>
                <tr>
                  <td><strong><%= r.label %></strong>
                    <% if (!r.is_required) { %><span class="badge bg-secondary">optional</span><% } %></td>
                  <td>
                    <% if (d) { %>
                      <span class="hint"><%= d.original_name %> (<%= (d.size/1024).toFixed(0) %> KB)</span>
                    <% } else { %>
                      <span class="text-danger">not uploaded</span>
                    <% } %>
                  </td>
                  <td class="hint"><%= d ? FMTDT(d.uploaded_at) : '—' %></td>
                  <td>
                    <% if (d) { %>
                      <span class="badge bg-<%= d.status === 'accepted' ? 'success' : (d.status === 'rejected' ? 'danger' : 'warning text-dark') %>"><%= d.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <% if (d) { %><a class="btn btn-outline-primary btn-sm" href="/files/document/<%= d.id %>" target="_blank">View</a><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- History -->
      <div class="card">
        <div class="card-header">🕓 Status History</div>
        <div class="card-body">
          <ul class="timeline mb-0">
            <% history.forEach(function(hh) { %>
              <li class="done">
                <div class="tl-title"><%= STATUS_LABELS[hh.status] || hh.status %></div>
                <div class="tl-meta"><%= FMTDT(hh.created_at) %><% if (hh.changed_by_name) { %> · <%= hh.changed_by_name %><% } %></div>
                <% if (hh.remarks) { %><div class="hint"><%= hh.remarks %></div><% } %>
              </li>
            <% }) %>
            <% if (!history.length) { %><li><div class="tl-meta">No history yet (draft).</div></li><% } %>
          </ul>
        </div>
      </div>
    </div>

    <!-- ============================ RIGHT: ACTIONS ============================== -->
    <div class="col-lg-4">
      <!-- Approval panel -->
      <% if (['draft','submitted','under_review','returned'].includes(app.status)) { %>
        <div class="card mb-3">
          <div class="card-header">✔ Review Actions</div>
          <div class="card-body">
            <form method="post" action="/admin/applicants/<%= app.id %>/status">
              <!-- Approve -->
              <div class="mb-3">
                <label class="form-label">Assign Section</label>
                <select class="form-select form-select-sm" name="section_id">
                  <option value="">— auto-assign (most free slots) —</option>
                  <% sections.forEach(function(s) { %>
                    <option value="<%= s.id %>" <%= app.section_id === s.id ? 'selected' : '' %>>
                      <%= s.name %><% if (s.strand) { %> (<%= s.strand.code %>)<% } %>
                      — <%= s.remaining %>/<%= s.capacity %> free
                    </option>
                  <% }) %>
                </select>
                <div class="hint">Approved students go to “For Assessment” (payment) next.</div>
              </div>
              <div class="d-grid gap-2 mb-3">
                <button class="btn btn-success" name="action" value="approve" type="submit"
                        data-confirm-link="Approve this application and assign a section?">✔ Approve Application</button>
                <button class="btn btn-outline-primary" name="action" value="review" type="submit"
                        <%= app.status === 'under_review' ? 'disabled' : '' %>>👁 Mark Under Review</button>
              </div>

              <!-- Return -->
              <label class="form-label">Remarks (required for Return / Reject)</label>
              <textarea class="form-control form-control-sm mb-2" name="remarks" rows="2"
                        placeholder="e.g. Please upload a clearer copy of your PSA birth certificate…"></textarea>
              <div class="d-grid gap-2">
                <button class="btn btn-outline-warning" name="action" value="return" type="submit"
                        data-confirm-link="Return this application to the student for correction?">↩ Return for Correction</button>
                <button class="btn btn-outline-danger" name="action" value="reject" type="submit"
                        data-confirm-link="REJECT this application? This cannot be undone lightly.">✖ Reject Application</button>
              </div>
            </form>
          </div>
        </div>
      <% } else { %>
        <div class="card mb-3">
          <div class="card-header">Status</div>
          <div class="card-body">
            <div class="assigned-section text-center">
              <span class="status-badge bg-<%= STATUS_COLORS[app.status] %> fs-6"><%= STATUS_LABELS[app.status] %></span>
              <% if (app.section_name) { %>
                <div class="mt-2"><strong>Section:</strong> <%= app.section_name %></div>
              <% } %>
              <% if (app.remarks) { %><div class="hint mt-2"><%= app.remarks %></div><% } %>
            </div>
            <% if (app.status === 'approved' && !payment) { %>
              <div class="alert alert-info py-2 mt-3 mb-0">Waiting for the student to upload payment proof.</div>
            <% } %>
            <% if (payment) { %>
              <div class="mt-3 small">
                <strong>Payment:</strong> <%= PAY(payment.amount) %> —
                <span class="badge bg-<%= payment.status === 'verified' ? 'success' : (payment.status === 'rejected' ? 'danger' : 'warning text-dark') %>"><%= payment.status %></span>
                <div class="hint"><%= payment.method %> <%= payment.reference_no ? '· ' + payment.reference_no : '' %></div>
                <% if (payment.slip_stored_name) { %>
                  <a class="btn btn-outline-primary btn-sm mt-1" href="/files/payment/<%= payment.id %>" target="_blank">View payment proof</a>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Assessment -->
      <div class="card mb-3">
        <div class="card-header">🧾 Fee Assessment</div>
        <div class="card-body">
          <table class="table table-sm small mb-2">
            <% assessment.fees.forEach(function(f) { %>
              <tr><td><%= f.name %></td><td class="text-end"><%= PAY(f.amount) %></td></tr>
            <% }) %>
            <% if (!assessment.fees.length) { %>
              <tr><td class="text-muted">No fees configured for this grade/strand.</td></tr>
            <% } %>
          </table>
          <div class="d-flex justify-content-between fw-bold">
            <span>TOTAL</span><span><%= PAY(assessment.total) %></span>
          </div>
        </div>
      </div>

      <!-- Student account -->
      <div class="card">
        <div class="card-header">👤 Account</div>
        <div class="card-body small">
          <div class="d-flex justify-content-between mb-1"><span>Type</span><strong class="text-uppercase"><%= app.enrollment_type %></strong></div>
          <div class="d-flex justify-content-between mb-1"><span>Target grade</span><strong><%= app.grade_name %></strong></div>
          <div class="d-flex justify-content-between"><span>Submitted</span><strong><%= FMTDT(app.submitted_at) %></strong></div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
