<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — <%= settings.school_name %></title>
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="no-print text-center mt-3">
  <a class="btn btn-outline-secondary btn-sm" href="/dashboard">← Dashboard</a>
  <button class="btn btn-success btn-sm" onclick="window.print()">🖨 Print</button>
</div>

<div class="sheet">
  <div class="sheet-head">
    <img src="<%= settings.logo_path %>" alt="logo">
    <div>
      <p class="school"><%= settings.school_name %></p>
      <p class="addr"><%= settings.school_address %></p>
      <p class="addr"><%= settings.school_contact %></p>
    </div>
  </div>

  <div class="sheet-title">Assessment of School Fees</div>
  <div class="sheet-sub">
    School Year <%= full.sy_name %> · Reference No: <strong><%= full.reference_no || '—' %></strong>
  </div>

  <table class="table table-bordered small">
    <tbody>
      <tr><th style="width:35%">Student</th><td><%= h.fullName(full) %> <% if (full.lrn) { %>(LRN <%= full.lrn %>)<% } %></td></tr>
      <tr><th>Grade Level / Strand</th>
        <td><%= full.grade_name %><%= full.strand_name ? ' — ' + full.strand_code : '' %></td></tr>
      <tr><th>Section</th><td><%= full.section_name || 'To be assigned' %></td></tr>
      <tr><th>Enrollment Status</th><td><strong><%= h.STATUS_LABELS[full.status] %></strong></td></tr>
    </tbody>
  </table>

  <table class="table table-bordered">
    <thead><tr><th>Fee Description</th><th>Category</th><th class="text-end">Amount</th></tr></thead>
    <tbody>
      <% assessment.fees.forEach(function(f) { %>
        <tr>
          <td><%= f.name %></td>
          <td class="text-capitalize"><%= f.category %></td>
          <td class="text-end"><%= h.peso(f.amount) %></td>
        </tr>
      <% }) %>
      <% if (!assessment.fees.length) { %>
        <tr><td colspan="3" class="text-center text-muted">No fees configured for this grade level.</td></tr>
      <% } %>
    </tbody>
    <tfoot>
      <tr class="table-success">
        <th colspan="2">TOTAL ASSESSED</th>
        <th class="text-end"><%= h.peso(assessment.total) %></th>
      </tr>
    </tfoot>
  </table>

  <div class="assigned-section mt-3 small">
    <strong>Payment status:</strong>
    <% if (payment) { %>
      <%= payment.status.toUpperCase() %> — <%= h.peso(payment.amount) %>
      (<%= payment.method === 'deposit_slip' ? 'Deposit slip' : 'Online reference' %>
      <%= payment.reference_no ? '· ' + payment.reference_no : '' %>)
      <% if (payment.verified_at) { %>· verified <%= h.fmtDateTime(payment.verified_at) %><% } %>
    <% } else { %>
      No payment submitted yet. Upload your deposit slip or payment reference from your dashboard.
    <% } %>
  </div>

  <div class="sig-row">
    <div class="sig"><div class="name">____________________</div><div class="role">Cashier / Finance</div></div>
    <div class="sig"><div class="name">____________________</div><div class="role">Registrar</div></div>
    <div class="sig"><div class="name">____________________</div><div class="role">Parent / Guardian</div></div>
  </div>
  <p class="hint text-center mt-4">Generated <%= h.fmtDateTime(new Date().toISOString()) %> · Fees are non-transferable.
    Present this at the cashier when paying.</p>
</div>

<script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
</body>
</html>
