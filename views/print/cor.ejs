<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — <%= settings.school_name %></title>
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="no-print text-center mt-3">
  <a class="btn btn-outline-secondary btn-sm" href="/dashboard">← Dashboard</a>
  <button class="btn btn-success btn-sm" onclick="window.print()">🖨 Print COR</button>
</div>

<div class="sheet">
  <div class="sheet-head">
    <img src="<%= settings.logo_path %>" alt="logo">
    <div>
      <p class="school"><%= settings.school_name %></p>
      <p class="addr"><%= settings.school_address %></p>
      <p class="addr"><%= settings.school_contact %></p>
    </div>
  </div>

  <div class="sheet-title">Certificate of Registration</div>
  <div class="sheet-sub">
    School Year <strong><%= full.sy_name %></strong> ·
    Reference No: <strong><%= full.reference_no || '—' %></strong> ·
    OR No: <strong><%= payment && payment.reference_no ? payment.reference_no : '________' %></strong>
  </div>

  <table class="table table-bordered small">
    <tbody>
      <tr>
        <th style="width:22%">Student</th><td><strong><%= h.fullName(full) %></strong></td>
        <th style="width:18%">LRN</th><td><%= full.lrn || '—' %></td>
      </tr>
      <tr>
        <th>Grade Level</th><td><%= full.grade_name %></td>
        <th>Track / Strand</th><td><%= full.strand_name ? full.strand_code + ' — ' + full.strand_name : 'N/A (JHS)' %></td>
      </tr>
      <tr>
        <th>Section</th><td><strong><%= full.section_name || 'TBA' %></strong></td>
        <th>Class Adviser</th><td><%= adviser || 'TBA' %></td>
      </tr>
      <tr>
        <th>Enrollment Type</th><td class="text-uppercase"><%= full.enrollment_type %></td>
        <th>Status</th><td><strong class="text-success">ENROLLED</strong></td>
      </tr>
      <tr>
        <th>Schedule</th>
        <td colspan="3">
          Monday to Friday ·
          <% if (full.grade_name && full.grade_name.indexOf('11') >= 0 || full.grade_name && full.grade_name.indexOf('12') >= 0) { %>
            7:30 AM – 4:30 PM (SHS regular schedule)
          <% } else { %>
            7:30 AM – 3:30 PM (JHS regular schedule)
          <% } %>
          — confirmed by the student on <%= full.schedule_confirmed ? h.fmtDate(full.enrolled_at) : '________' %>
        </td>
      </tr>
    </tbody>
  </table>

  <div class="section-sub">Subjects Enrolled</div>
  <table class="table table-bordered small">
    <thead><tr><th style="width:60px">No.</th><th>Subject</th><th style="width:80px">Units</th></tr></thead>
    <tbody>
      <% subjects.forEach(function(s, i) { %>
        <tr><td><%= i + 1 %></td><td><%= s.name %></td><td class="text-center"><%= s.units %></td></tr>
      <% }) %>
      <% if (!subjects.length) { %>
        <tr><td colspan="3" class="text-center text-muted">No subjects configured for this grade/strand yet.</td></tr>
      <% } %>
    </tbody>
  </table>

  <div class="section-sub">Accountability / Fees</div>
  <table class="table table-bordered small">
    <thead><tr><th>Fee</th><th class="text-end">Amount</th></tr></thead>
    <tbody>
      <% assessment.fees.forEach(function(f) { %>
        <tr><td><%= f.name %></td><td class="text-end"><%= h.peso(f.amount) %></td></tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr class="table-success"><th>TOTAL</th><th class="text-end"><%= h.peso(assessment.total) %></th></tr>
      <tr><th>Payment</th><td class="text-end">
        <%= payment ? (payment.status === 'verified' ? 'PAID — ' + h.peso(payment.amount) : payment.status.toUpperCase()) : 'PENDING' %>
      </td></tr>
    </tfoot>
  </table>

  <div class="alert alert-secondary small mt-3" style="border-radius:8px">
    I hereby certify that I have read, understood and agree to abide by the school's policies, rules and regulations,
    and that the information provided in this registration is true and correct.
  </div>

  <div class="sig-row">
    <div class="sig"><div class="name"><%= h.fullName(full) %></div><div class="role">Student / Parent</div></div>
    <div class="sig"><div class="name"><%= adviser || '____________________' %></div><div class="role">Adviser</div></div>
    <div class="sig"><div class="name">____________________</div><div class="role">Registrar</div></div>
    <div class="sig"><div class="name">____________________</div><div class="role">Principal</div></div>
  </div>

  <p class="hint text-center mt-4">
    Generated <%= h.fmtDateTime(new Date().toISOString()) %> ·
    <%= settings.school_name %> — Online Enrollment Module · Keep this for your records.
  </p>
</div>

<script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
</body>
</html>
