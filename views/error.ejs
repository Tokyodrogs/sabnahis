<%- include('partials/head') %>
<div class="container page-wrap">
  <div class="text-center py-5">
    <div style="font-size:3.5rem">🤔</div>
    <h1 class="page-title mt-2"><%= typeof code !== 'undefined' ? code : 500 %> — <%= title %></h1>
    <p class="page-sub"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
    <a class="btn btn-success mt-3" href="<%= user ? (user.role === 'applicant' ? '/dashboard' : '/admin') : '/' %>">
      ← Go Back
    </a>
  </div>
</div>
<%- include('partials/foot') %>
