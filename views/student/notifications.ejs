<%- include('../partials/head') %>

<div class="container page-wrap">
  <div class="page-title-row">
    <div>
      <h1 class="page-title">🔔 Notifications</h1>
      <p class="page-sub">Updates from the registrar and enrollment system.</p>
    </div>
    <form method="post" action="/notifications/read">
      <button class="btn btn-outline-secondary btn-sm" type="submit">Mark all as read</button>
    </form>
  </div>

  <div class="card">
    <div class="list-group list-group-flush">
      <% if (!notices.length) { %>
        <div class="list-group-item text-center text-muted py-5">No notifications yet.</div>
      <% } %>
      <% notices.forEach(function(n) { %>
        <a href="/notifications/<%= n.id %>/read"
           class="list-group-item list-group-item-action notif-item <%= n.is_read ? '' : 'unread' %> py-3">
          <div class="d-flex justify-content-between">
            <strong class="small"><%= n.title %></strong>
            <span class="hint"><%= FMTDT(n.created_at) %></span>
          </div>
          <div class="small text-muted"><%= n.body %></div>
        </a>
      <% }) %>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
